# Local defaults. Copy to .env.local for Next; export backend variables in your shell.
RISKLENS_BACKEND_URL=http://127.0.0.1:8000
RISKLENS_ENV=development
RISKLENS_IDENTITY_ADAPTER=development
# Opt-in IAP requires the exact signed-header audience and a private server-side grants file.
RISKLENS_IAP_AUDIENCE=
RISKLENS_STAFF_GRANTS_FILE=
RISKLENS_PROVIDER=local
RISKLENS_ENABLE_VERTEX=false
RISKLENS_AUTO_SEED=false
RISKLENS_DATABASE_DRIVER=sqlite
# Set absolute persistent paths if using a different local volume.
# RISKLENS_STORAGE_DIR=
# RISKLENS_DB=
# RISKLENS_CHECKPOINT_DB=
# Local defaults remain offline. To opt into the verified VM Vertex profile:
# RISKLENS_PROVIDER=vertex; RISKLENS_ENABLE_VERTEX=true
# Project: ai-builders-cup; location: global; model: gemini-3.5-flash-lite
# Configure the backend service environment; no Gemini API key is needed.
# Model/location and data-handling requirements are deployment choices.
RISKLENS_GCP_PROJECT=
RISKLENS_GCP_LOCATION=
RISKLENS_VERTEX_MODEL=
