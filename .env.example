# Local defaults. Copy to .env.local for Next; export backend variables in your shell.
RISKLENS_BACKEND_URL=http://127.0.0.1:8000
RISKLENS_ENV=development
RISKLENS_PROVIDER=local
RISKLENS_ENABLE_VERTEX=false
RISKLENS_AUTO_SEED=false
RISKLENS_DATABASE_DRIVER=sqlite
# Set absolute persistent paths if using a different local volume.
# RISKLENS_STORAGE_DIR=
# RISKLENS_DB=
# RISKLENS_CHECKPOINT_DB=
# Deliberately blank until G02/G09. Model/location are deployment choices.
RISKLENS_GCP_PROJECT=
RISKLENS_GCP_LOCATION=
RISKLENS_VERTEX_MODEL=
