{
  "name": "bankweave-ai",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/runtime/dev.mjs",
    "build": "npm run build --workspace @bankweave/frontend --",
    "start": "node scripts/runtime/dev.mjs start",
    "frontend:start": "node scripts/runtime/frontend.mjs",
    "backend:start": "bash scripts/runtime/start-vm-backend.sh",
    "backend:seed": "tsx scripts/data/export-demo.ts && node scripts/runtime/python.mjs -m backend.features.datasets.demo_import",
    "backend:migrate": "node scripts/runtime/python.mjs -m backend.cli.migrate",
    "test:backend": "node scripts/runtime/python.mjs -m unittest discover -s backend/tests -t . -v",
    "evaluate": "node scripts/runtime/python.mjs -m backend.evaluation.offline",
    "typecheck": "npm run typecheck --workspace @bankweave/frontend && tsc --noEmit -p tsconfig.json",
    "test": "tsx --test frontend/tests/unit/*.test.ts",
    "test:e2e": "playwright test --config frontend/playwright.config.ts",
    "format": "prettier --write frontend/src frontend/tests frontend/*.ts demo scripts docs *.json *.md",
    "campaigns:generate": "node scripts/runtime/python.mjs scripts/data/generate-campaign-data.py",
    "campaigns:worker": "node scripts/runtime/campaign-supervisor.mjs",
    "check:structure": "node scripts/checks/verify_structure.mjs && node scripts/runtime/python.mjs scripts/checks/verify_structure.py",
    "check:secrets": "node scripts/runtime/python.mjs scripts/checks/verify_public_source.py"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "prettier": "^3.9.9",
    "@next/env": "16.3.8"
  }
}
