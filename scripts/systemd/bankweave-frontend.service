[Unit]
Description=BankWeave Next.js production frontend
Wants=bankweave-backend.service
After=bankweave-backend.service
PartOf=bankweave-private.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=%h/BankWeaveAI
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/bankweave/frontend.env
ExecStartPre=%h/.local/bin/node %h/BankWeaveAI/scripts/wait-backend.mjs
ExecStart=%h/.local/bin/npm run frontend:start
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
