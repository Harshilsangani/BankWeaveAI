[Unit]
Description=BankWeave isolated judge API
PartOf=bankweave-judge.target

[Service]
Type=simple
WorkingDirectory=%h/bankweave-judge-app
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/bankweave/judge-backend.env
ExecStart=/usr/bin/bash %h/bankweave-judge-app/scripts/runtime/start-vm-backend.sh
Restart=always
RestartSec=5
TimeoutStopSec=120
KillMode=control-group
UMask=0077
